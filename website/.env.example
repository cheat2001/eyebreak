# EyeBreak Website Environment Variables
# Copy this file to .env for local development

# App Information
VITE_APP_VERSION=2.3.0
VITE_APP_NAME=EyeBreak

# GitHub Repository
VITE_GITHUB_OWNER=cheat2001
VITE_GITHUB_REPO=eyebreak
VITE_GITHUB_URL=https://github.com/cheat2001/eyebreak

# Website URLs
VITE_SITE_URL=https://eyebreak.app
VITE_DOWNLOAD_URL=https://github.com/cheat2001/eyebreak/releases/latest

# macOS Requirements
VITE_MIN_MACOS_VERSION=14.0+

# Donation Links
VITE_PAYPAL_URL=https://www.paypal.com/donate/?hosted_button_id=KSQCFH8HU6DZN
VITE_KHQR_URL=https://pay.ababank.com/oRF8/fnuxbuun

# Optional: Analytics
# VITE_GA_TRACKING_ID=
# VITE_PLAUSIBLE_DOMAIN=eyebreak.app

# AI Chatbot (Groq API)
# Get your API key from: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
